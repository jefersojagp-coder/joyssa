{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.mjs"
  },
  "mutate": ["dist/lib/motion.js", "dist/lib/observability.js"],
  "reporters": ["clear-text", "html", "json"],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "disableTypeChecks": false,
  "ignorePatterns": [
    "**",
    "!dist/**/*.js",
    "!dist/index.html",
    "!tests/unit/**/*.js",
    "!tests/integration/**/*.js",
    "!vitest.config.mjs",
    "!package.json"
  ]
}
