{
  "name": "joy-sushi-bar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "lint": "biome check dist/app.js dist/lib tests scripts *.json *.mjs",
    "lint:fix": "biome check --write dist/app.js dist/lib tests scripts *.json *.mjs",
    "knip": "knip",
    "arch:check": "arch-contract check && node scripts/check-architecture.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "commitlint": "commitlint",
    "check": "npm run lint && npm run knip && npm run arch:check && npm run test:coverage",
    "build:monitoring": "node scripts/build-monitoring.mjs",
    "seo:preview": "node scripts/prepare-seo.mjs preview",
    "seo:production": "node scripts/prepare-seo.mjs production"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "arch-contract": "0.3.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "knip": "6.35.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@sentry/browser": "10.74.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
